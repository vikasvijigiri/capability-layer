{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start/02-bootstrap-docs.py\"",
            "statusMessage": "Loading knowledge docs into session context..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start/03-state-report.py\"",
            "statusMessage": "Measuring repo state against the branch point..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/user-prompt/01-entry-classifier.py\"",
            "statusMessage": "Classifying the prompt's workflow entry shape..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-run/03-checkpoint.py\"",
            "statusMessage": "Writing recovery checkpoint..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-run/06-artifact-autocommit.py\"",
            "statusMessage": "Checkpointing this turn's work..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-run/07-layer-drift.py\"",
            "statusMessage": "Checking capability-layer drift..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-run/08-chain-continuity.py\"",
            "statusMessage": "Recording chain state..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-run/01-halt-guard.py\"",
            "statusMessage": "Checking for a halt..."
          }
        ],
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit|Task"
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit/01-secret-scan.py\"",
            "statusMessage": "Scanning staged files for secrets..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit/02-branch-guard.py\"",
            "statusMessage": "Checking commit destination branch..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-deploy/01-spend-guard.py\"",
            "statusMessage": "Running deploy spend guard checks..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit/03-attribution-guard.py\"",
            "statusMessage": "Checking the commit message and author for AI attribution..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit/01-forbidden-change-guard.py\"",
            "statusMessage": "Checking the target is not generated or vendored..."
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit/02-agent-scope-guard.py\"",
            "statusMessage": "Checking agent write scope..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/on-artifact-create/02-hook-self-test-nudge.py\"",
            "statusMessage": "Checking whether a hook script needs testing..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool/01-context-cost.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool/02-repeat-detector.py\""
          }
        ]
      }
    ]
  },
  "skillListingBudgetFraction": 0.02
}
