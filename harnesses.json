{
  "version": 1,
  "source_contract": "AGENTS.md",
  "canonical_root": ".claude",
  "execution_model": "host-managed",
  "hook_bridge_doc": "docs/harness-hook-bridge.md",
  "native_hosts": ["Claude Code"],
  "integration_targets": ["Codex", "generic-agent"],
  "policy": {
    "single_source_of_truth": ".claude",
    "no_parallel_sources": true,
    "generated_projections_are_artifacts": false,
    "all_hosts_must_read": [
      "AGENTS.md",
      ".claude/workflow.md"
    ]
  },
  "canonical_paths": {
    "skills": ".claude/skills",
    "agents": ".claude/agents",
    "commands": ".claude/commands",
    "workflow_policy": ".claude/workflow.md",
    "workflows": ".claude/workflows",
    "policies": ".claude/policies",
    "rules": ".claude/rules",
    "hooks": ".claude/hooks",
    "settings": ".claude/settings.json",
    "local_settings": ".claude/settings.local.json",
    "output_styles": ".claude/output-styles",
    "agent_memory": ".claude/agent-memory",
    "project_checks": ".claude/project-checks.json",
    "adapters": ".claude/adapters",
    "portability_contract": ".claude/portability/capabilities.json",
    "baselines": "docs/baselines",
    "pilot_fixtures": "docs/pilots",
    "workflow_state": ".claude/workflow-state"
  },
  "adapters": {
    "claude-code": {
      "instruction_file": "CLAUDE.md",
      "source_paths": "canonical_paths",
      "skills_path": ".claude/skills",
      "agents_path": ".claude/agents",
      "commands_path": ".claude/commands",
      "workflow_policy_path": ".claude/workflow.md",
      "rules_path": ".claude/rules",
      "hooks_path": ".claude/hooks",
      "settings_path": ".claude/settings.json",
      "adapter_manifest": ".claude/adapters/claude-code.json",
      "status": "native-canonical"
    },
    "codex": {
      "instruction_file": "AGENTS.md",
      "source_paths": "canonical_paths",
      "skills_path": ".claude/skills",
      "agents_path": ".claude/agents",
      "commands_path": ".claude/commands",
      "workflow_policy_path": ".claude/workflow.md",
      "rules_path": ".claude/rules",
      "hooks_path": ".claude/hooks",
      "settings_path": ".claude/settings.json",
      "adapter_manifest": ".claude/adapters/codex.json",
      "status": "bridge-required-unverified",
      "hooks_note": "Codex does not auto-discover Claude lifecycle registration; invoke the canonical hook checks explicitly per docs/harness-hook-bridge.md."
    },
    "generic-agent": {
      "instruction_file": "AGENTS.md",
      "source_paths": "canonical_paths",
      "skills_path": ".claude/skills",
      "agents_path": ".claude/agents",
      "commands_path": ".claude/commands",
      "workflow_policy_path": ".claude/workflow.md",
      "rules_path": ".claude/rules",
      "hooks_path": ".claude/hooks",
      "settings_path": ".claude/settings.json",
      "adapter_manifest": ".claude/adapters/generic-agent.json",
      "status": "bridge-required-unverified",
      "hooks_note": "Generic hosts must invoke canonical hook checks through their own lifecycle API per docs/harness-hook-bridge.md."
    }
  }
}
